{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "config.activities.schema.json",
  "title": "生产活动（content/config/activities.json）",
  "description": "生产活动 = 采集与炼丹（MVP；CONTEXT.md 生产活动词条，不做知识/生活技能）。活动等级与经验是运行时状态存存档，内容侧只放等级参数（content.md progression 规则）。",
  "type": "object",
  "required": ["activities"],
  "properties": {
    "activities": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/definitions/activity" }
    }
  },
  "additionalProperties": false,
  "definitions": {
    "activity": {
      "type": "object",
      "required": ["id", "name", "progression"],
      "dependencies": { "rates": ["cycleSeconds"] },
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^act-[a-z0-9-]+$",
          "description": "如 act-practice / act-herb-gather / act-alchemy"
        },
        "name": {
          "type": "string",
          "minLength": 1,
          "description": "活动名（练功 / 采集 / 炼丹）"
        },
        "progression": {
          "type": "object",
          "description": "内容侧只放等级参数；玩家当前等级与经验是运行时状态，不写进内容条目（content.md）。",
          "required": ["maxLevel"],
          "properties": {
            "maxLevel": { "type": "integer", "minimum": 1 },
            "xpPerCycle": { "type": "integer", "minimum": 0 }
          },
          "additionalProperties": false
        },
        "rates": {
          "type": "array",
          "description": "活动直接产出的资源列表；产出为物品（如药材）的活动可为空数组，此时产出由物品表定义（content.md）。",
          "items": {
            "type": "object",
            "required": ["resourceId"],
            "properties": {
              "resourceId": { "type": "string" },
              "amountPerCycle": { "type": "integer", "minimum": 0 },
              "weight": { "type": "number", "minimum": 0 }
            },
            "additionalProperties": false
          }
        },
        "cycleSeconds": {
          "type": "integer",
          "minimum": 1,
          "description": "一个产出周期的秒数（离线按周期数结算，O(1)）"
        },
        "offlineCapHours": {
          "type": "integer",
          "minimum": 0,
          "description": "离线结算上限（小时）。超时不计——制造回归动机（CONTEXT.md 离线结算词条）。"
        },
        "requires": {
          "type": "object",
          "description": "进入门槛：推荐战力下限与/或生产活动等级下限（ADR-0019：境界已废，改用 recommendedPower / powerMin 区间）。",
          "properties": {
            "powerMin": { "type": "integer", "minimum": 0 },
            "activityLevelMin": { "type": "integer", "minimum": 1 }
          },
          "additionalProperties": false
        },
        "inputs": {
          "type": "array",
          "description": "消耗（炼丹用：药材 + 丹方）。丹方本体在 content/pill/。",
          "items": {
            "type": "object",
            "required": ["itemId", "amount"],
            "properties": {
              "itemId": { "type": "string" },
              "amount": { "type": "integer", "minimum": 1 }
            },
            "additionalProperties": false
          }
        },
        "description": {
          "type": "string",
          "description": "叙事文本，须遵守 content/style-guide.md"
        }
      },
      "additionalProperties": false
    }
  }
}
