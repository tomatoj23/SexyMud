{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "combat-text.schema.json",
  "title": "combat-text 条目（模板 + 词库）",
  "description": "草案（设计定稿，core 校验器实现时生效）。模板条目与词库条目均落在 content/combat-text/ 下，由 oneOf 分流。id 规则：小写字母、数字、连字符（docs/agents/content.md）。",
  "type": "object",
  "oneOf": [
    { "$ref": "#/definitions/template" },
    { "$ref": "#/definitions/poolEntry" }
  ],
  "definitions": {
    "template": {
      "type": "object",
      "required": ["id", "kind", "segments"],
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$" },
        "kind": { "const": "template" },
        "segments": {
          "description": "片段序列，可变长度：下乘 3 段／中乘 4 段／上乘 5-6 段／绝学 7 段",
          "type": "array",
          "minItems": 3,
          "maxItems": 7,
          "items": { "type": "string", "minLength": 1 }
        },
        "quality": { "enum": ["下乘", "中乘", "上乘", "绝学"] },
        "example": { "type": "string" }
      },
      "additionalProperties": false
    },
    "poolEntry": {
      "description": "词库条目：后果词库 5 维分池（damageBand × lifeBand × source × motion × element）；动词/部位/修饰片段按各自维度过滤",
      "type": "object",
      "required": ["id", "kind", "text", "dims"],
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$" },
        "kind": {
          "enum": [
            "consequence",
            "verb",
            "limb",
            "opening",
            "moveIntro",
            "weaponAction",
            "elementFlavor"
          ]
        },
        "text": { "type": "string", "minLength": 1 },
        "dims": {
          "type": "object",
          "properties": {
            "damageBand": { "$ref": "#/definitions/dimensionRef" },
            "lifeBand": { "$ref": "#/definitions/dimensionRef" },
            "source": { "$ref": "#/definitions/dimensionRef" },
            "motion": { "$ref": "#/definitions/dimensionRef" },
            "element": { "$ref": "#/definitions/dimensionRef" }
          },
          "additionalProperties": false
        },
        "limbs": {
          "description": "动词条目专用：部位白名单（与 limb 词库的搭配约束）",
          "type": "array",
          "items": { "type": "string", "minLength": 1 },
          "uniqueItems": true
        }
      },
      "additionalProperties": false
    },
    "dimensionRef": {
      "description": "维度取值（单值或集合）。取值合法性、增删由 content/config/dimensions.json 维度表管；本 schema 不写死枚举（引擎零写死，ADR-0004 扩展留白）",
      "type": ["string", "array"],
      "items": { "type": "string", "minLength": 1 }
    }
  }
}
