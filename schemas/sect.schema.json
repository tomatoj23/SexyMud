{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "sect.schema.json",
  "title": "门派（content/sect/，每条目一文件）",
  "description": "门派 = 武功池 + 缺省系别 + 生产加成（外加贡献货币、脉、师父）。同一时间只属一个门派；已学武功必须与当前门派解耦。",
  "type": "object",
  "required": ["id", "name"],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^sect-[a-z0-9-]+$",
      "description": "如 sect-gb（丐帮）"
    },
    "name": { "type": "string", "minLength": 1 },
    "defaultElements": {
      "type": "array",
      "description": "缺省系别（如丐帮 火/雷、武当 水/土、唐门 木/金）。取值来自 dimensions 的 element 维度。",
      "items": { "type": "string" }
    },
    "tempo": {
      "type": "string",
      "description": "节奏差异：爆发型 / 持久型 / 累积型。叙事与文案用，引擎不读。"
    },
    "martialPool": {
      "type": "array",
      "description": "本门派可学的武功 id（content/martial/）。门派只是获取来源，不是所有权。",
      "items": { "type": "string" }
    },
    "lineages": {
      "type": "array",
      "description": "脉（lineageId）：武功池的细分标签，不是玩家的身份选择——可同时拥有多个，由装配（招式 4 / 心法 3）来\"选\"。",
      "items": {
        "type": "object",
        "required": ["id", "name"],
        "properties": {
          "id": { "type": "string" },
          "name": { "type": "string", "minLength": 1 },
          "martialIds": { "type": "array", "items": { "type": "string" } }
        },
        "additionalProperties": false
      }
    },
    "productionBonus": {
      "type": "array",
      "description": "生产加成（采集／炼丹效率等），走修饰符管线",
      "items": { "type": "object" }
    },
    "contributionResourceId": {
      "type": "string",
      "description": "门派贡献对应的资源 id（content/config/resources.json）。MVP 中不可跨门派使用。"
    },
    "exchange": {
      "type": "array",
      "description": "贡献兑换清单（门派商店货架）：以贡献货币计价，引用任意内容条目 id（兽、秘籍、丹方等），加商品 = 纯内容追加。兽（content/beast/）的获取走这里（ADR-0013）。",
      "items": {
        "type": "object",
        "required": ["itemId", "cost"],
        "properties": {
          "itemId": { "type": "string", "description": "被兑换条目的 id（content/ 任意集合）" },
          "cost": { "type": "number", "minimum": 0, "description": "贡献货币价格" }
        },
        "additionalProperties": false
      }
    },
    "masters": {
      "type": "array",
      "description": "师父字段（sect.masters）。MVP 只留字段、无实际内容；\"学习武功\"流程带条件检查点，将来做拜师门槛不动流程、只改配置（CONTEXT.md 师承词条）。",
      "items": {
        "type": "object",
        "properties": {
          "id": { "type": "string" },
          "name": { "type": "string" },
          "title": { "type": "string" }
        },
        "additionalProperties": true
      }
    },
    "relations": {
      "type": "array",
      "description": "门派间关系是一张内容表（正派/魔教、同盟/敌对将来会变），引擎只查表",
      "items": {
        "type": "object",
        "properties": {
          "sectId": { "type": "string" },
          "relation": { "type": "string" }
        },
        "additionalProperties": false
      }
    },
    "entryCondition": {
      "type": "object",
      "description": "入门条件。MVP 条件恒真，但\"学习武功\"流程带条件检查点",
      "additionalProperties": {}
    },
    "art": { "type": "string" },
    "description": {
      "type": "string",
      "description": "叙事文本（1~3 句），须遵守 content/style-guide.md"
    },
    "tags": { "$ref": "common.schema.json#/definitions/tags" },
    "flags": { "$ref": "common.schema.json#/definitions/flags" },
    "prototypeKey": { "$ref": "common.schema.json#/definitions/prototypeKey" },
    "prototypeParent": { "$ref": "common.schema.json#/definitions/prototypeParent" }
  },
  "additionalProperties": false
}
