{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "equipment.schema.json",
  "title": "装备：底材与词缀（content/equipment/，每条目一文件）",
  "description": "底材 = 分层条目（高层掉另一个底材，不是同一条目加 itemLevel）；词缀条目内含 3 阶数值表（对「每条目一文件」的有意例外）。由 oneOf 分流。依据 ADR-0012、。",
  "type": "object",
  "oneOf": [
    { "$ref": "#/definitions/base" },
    { "$ref": "#/definitions/affix" }
  ],
  "definitions": {
    "base": {
      "title": "底材",
      "type": "object",
      "required": ["id", "kind", "name", "slot", "floorRange", "tierRange"],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^base-[a-z0-9-]+$",
          "description": "如 base-heavy-sword。每个底材一个 id = 一张图标（ADR-0003 资产约定路径）"
        },
        "kind": { "const": "base" },
        "name": { "type": "string", "minLength": 1 },
        "slot": {
          "type": "string",
          "description": "槽位。取值来自 content/config/dimensions.json 的 slot 维度；当前 7 槽（兵/冠/甲/腕/腰/裤/靴）见 CONTEXT.md 装备槽词条——槽数是结构性配置，引擎零写死。"
        },
        "floorRange": {
          "type": "object",
          "description": "层数区间（哪个秘境层数段会掉落）。⚠️ 层数 = 装备有多强（深度），与造诣（人物深浅）不可混。",
          "required": ["min", "max"],
          "properties": {
            "min": { "type": "integer", "minimum": 1 },
            "max": { "type": "integer", "minimum": 1 }
          },
          "additionalProperties": false
        },
        "tierRange": {
          "type": "object",
          "description": "**阶位**范围（能出哪些阶位的词缀，T1~T3）。⚠️ 不是「品阶」——品阶是功法档次（下乘/中乘/上乘/绝学），词缀用阶位，两者是三件事之一（CONTEXT.md）。此字段在数据上锁死洗练天花板——洗练再多次也出不了更高阶。",
          "required": ["min", "max"],
          "properties": {
            "min": { "type": "integer", "minimum": 1 },
            "max": { "type": "integer", "minimum": 1 }
          },
          "additionalProperties": false
        },
        "preferredTags": {
          "type": "array",
          "description": "底材只声明**偏好键**（裸键列表，跨维度匹配词缀 tags 各维度的取值）；词缀自带 `tags`（对象形态），权重 = 基础 × (1 + 匹配键数 × 加成)",
          "items": { "type": "string" }
        },
        "inherentModifiers": {
          "type": "array",
          "description": "固有词缀：固定、非随机（掉落链第 ⑧ 步附加）",
          "items": { "type": "object" }
        },
        "art": { "type": "string", "description": "覆盖默认 assets/icons/equipment/<id>.png 时的相对路径" },
        "description": { "type": "string", "description": "叙事文本，须遵守 content/style-guide.md" },
        "tags": { "$ref": "common.schema.json#/definitions/tags" },
        "flags": { "$ref": "common.schema.json#/definitions/flags" },
        "prototypeKey": { "$ref": "common.schema.json#/definitions/prototypeKey" },
        "prototypeParent": { "$ref": "common.schema.json#/definitions/prototypeParent" }
      },
      "additionalProperties": false
    },
    "affix": {
      "title": "词缀",
      "type": "object",
      "required": ["id", "kind", "name", "tags", "tiers"],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^affix-[a-z0-9-]+$",
          "description": "如 affix-strength"
        },
        "kind": { "const": "affix" },
        "name": { "type": "string", "minLength": 1 },
        "tags": { "$ref": "common.schema.json#/definitions/tags" },
        "flags": { "$ref": "common.schema.json#/definitions/flags" },
        "prototypeKey": { "$ref": "common.schema.json#/definitions/prototypeKey" },
        "prototypeParent": { "$ref": "common.schema.json#/definitions/prototypeParent" },
        "tiers": {
          "type": "array",
          "description": "3 阶数值表（T1/T2/T3）：每条目内含三阶，便于调平衡（对「每条目一文件」的有意例外）",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": ["tier", "modifiers"],
            "properties": {
              "tier": { "type": "integer", "minimum": 1, "description": "词缀阶位序号（1-3，中文标签由 config 映射）" },
              "modifiers": { "type": "array", "items": { "type": "object" } }
            },
            "additionalProperties": false
          }
        },
        "feature": {
          "type": "boolean",
          "description": "是否特色词缀：不是数值，是改变机制（如\"你的中毒会传染\"）；绝世（5~6 词缀）含一条。复用 condition + primitive 表达，引擎零新增"
        },
        "description": { "type": "string", "description": "叙事文本，须遵守 content/style-guide.md" }
      },
      "additionalProperties": false
    }
  }
}
