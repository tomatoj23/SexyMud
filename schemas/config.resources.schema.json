{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "config.resources.schema.json",
  "title": "资源类型（content/config/resources.json）",
  "description": "资源 = 与药材/丹药/材料/货币并列的资源类型定义（CONTEXT.md 药材、门派贡献词条）。具体药材走 content/herb/、丹药走 content/pill/，本集合只定义资源类型本身。",
  "type": "object",
  "required": ["resources"],
  "properties": {
    "resources": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/definitions/resource" }
    }
  },
  "additionalProperties": false,
  "definitions": {
    "resource": {
      "type": "object",
      "required": ["id", "name", "kind"],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^res-[a-z0-9-]+$",
          "description": "如 res-experience（实战经验）、res-contribution（门派贡献）"
        },
        "name": { "type": "string", "minLength": 1 },
        "kind": {
          "type": "string",
          "description": "资源类别（进度 / 货币 / 材料 / 贡献）。取值可扩充，引擎不按具体值分支；中文显示名即 name 字段。"
        },
        "stackable": { "type": "boolean" },
        "maxStack": { "type": "integer", "minimum": 1 },
        "sectScoped": {
          "type": "boolean",
          "description": "是否门派内专用（门派贡献 MVP 中不可跨门派使用，CONTEXT.md）"
        },
        "description": {
          "type": "string",
          "description": "叙事文本，须遵守 content/style-guide.md"
        }
      },
      "additionalProperties": false
    }
  }
}
